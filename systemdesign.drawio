aries&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 20%;&quot;&gt;&lt;span style=&quot;font-size: 4px; background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 20%;&quot;&gt;&lt;span style=&quot;font-size: 4px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; Configuration&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 20%;&quot;&gt;&lt;span style=&quot;font-size: 4px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-size: 4px; background-color: transparent;&quot;&gt;• Listen on port 443&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 20%;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-size: 4px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-size: 4px; background-color: transparent;&quot;&gt;• No stored memory, just workers&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" vertex="1">

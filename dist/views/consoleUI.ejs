<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Linux Terminal</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: "Ubuntu Mono", "DejaVu Sans Mono", monospace;
      background: #111;
    }

    .terminal {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      background: #300a24;
      color: #f2f2f2;
    }

    /* Terminal title bar */
    

    /* Terminal body */
    .terminal-body {
      flex: 1;
      min-height: 0;
      padding: 14px 16px;
      overflow-y: auto;
      overflow-x: hidden;
      font-size: clamp(13px, 1.2vw, 16px);
      line-height: 1.45;
      cursor: text;
      scrollbar-width: thin;
      scrollbar-color: rgba(255,255,255,.2) transparent;
    }

    .terminal-body::-webkit-scrollbar {
      width: 8px;
    }

    .terminal-body::-webkit-scrollbar-track {
      background: transparent;
    }

    .terminal-body::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,.2);
      border-radius: 10px;
    }

    .line {
      white-space: pre-wrap;
      word-break: break-word;
    }

    .prompt {
      color: #8ae234;
    }

    .command {
      color: #fff;
    }

    .output {
      color: #eee;
    }

    .error {
      color: #ff6b6b;
    }

    .directory {
      color: #729fcf;
      font-weight: bold;
    }

    .executable {
      color: #8ae234;
      font-weight: bold;
    }

    /* Input row */
    .input-row {
      display: flex;
      align-items: baseline;
      width: 100%;
    }

    .input-wrapper {
      flex: 1;
      position: relative;
      min-width: 0;
    }

    #commandInput {
      width: 100%;
      padding: 0;
      margin: 0;
      border: 0;
      outline: none;
      background: transparent;
      color: white;
      font: inherit;
      caret-color: #fff;
    }

    /* Mobile */
    @media (max-width: 600px) {

      .window-buttons {
        right: 7px;
        gap: 5px;
      }

      .window-button {
        width: 10px;
        height: 10px;
      }

      .terminal-body {
        padding: 10px;
        font-size: 13px;
      }
    }
  </style>
</head>

<body>

  <div class="terminal" id="terminalParent">

    <div class="terminal-body" id="terminal">

  <div class="input-row">
    <span class="prompt">admin@NetBreaker:~$&nbsp;</span>

    <div class="input-wrapper">
      <input
        id="commandInput"
        type="text"
        autocomplete="off"
        autofocus
        spellcheck="false"
      />
    </div>
  </div>

</div>
  </div>


<script>
  const terminal = document.getElementById("terminal");
  const terminalParent = document.getElementById("terminalParent");
const input = document.getElementById("commandInput");

let history = [];
let historyIndex = -1;

function scrollToBottom() {
  terminal.scrollTop = terminal.scrollHeight;
}

function escapeHTML(text) {
  return text
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function addLine(content, className = "output") {
  const line = document.createElement("div");

  line.className = `line ${className}`;
  line.innerHTML = content;

  terminal.insertBefore(
    line,
    document.querySelector(".input-row")
  );
}
var shellPromtColor = "#8ae234"
function createPromptLine(command) {
  const line = document.createElement("div");

  line.className = "line";

  line.innerHTML =
    `<span class="prompt" style="color = ${shellPromtColor};">admin@NetBreaker:~$</span> <span class="postPrompt">${escapeHTML(command)}</span>`;

  terminal.insertBefore(
    line,
    document.querySelector(".input-row")
  );
}

function execute(command) {
  command = command.trim();

  if (!command) {
    return;
  }

  history.push(command);
  historyIndex = history.length;

  createPromptLine(command);

  // The ONLY supported command
  if (command === "clear") {
    terminal
      .querySelectorAll(".line:not(.input-row)")
      .forEach(line => line.remove());

    input.focus();
    return;
  }

  if (command.split(" ")[0] === "color") {
    terminalParent.style.backgroundColor = command.split(" ")[1]
    

    input.focus();
    return;
  }

  if (command.split(" ")[0] === "font"){
    //c1
    if(command.split(" ")[1] === "-family"){
        if(command.split(" ")[2] == "--list"){
            addLine("Sans-Serif Fonts :")
            addLine("   Arial")
            addLine("   Helvetica")
            addLine("   Verdana")
            addLine("   Tahoma")
            addLine("   ")
            addLine("Serif Fonts :")
            addLine("   Times New Roman")
            addLine("   Georgia")
            addLine("   Garamond")
            addLine("   ")
            addLine("Monospace Fonts :")
            addLine("   Courier New")
            addLine("   Lucida Console")
        }else{
            var commandStringFont = ""
            command.split(" ").forEach((element, index)=>{
                if(index <= 1){
                    commandStringFont = commandStringFont
                }else if(index == command.split(" ").length-1){
                    commandStringFont = commandStringFont + element
                }else{
                    commandStringFont = commandStringFont + element + " "
                }
            })
            document.getElementsByClassName("terminal-body")[0].style.fontFamily = commandStringFont + " , monospace"
        }
    }else if(command.split(" ")[1] === "-size"){
        document.getElementsByClassName("terminal-body")[0].style.fontSize = command.split(" ")[2] + "px"
    }else if(command.split(" ")[1] === "-color"){
        if(command.split(" ")[2] === "-shellPrompt"){
            shellPromtColor = (command.split(" ")[3]+"").toString()
            document.querySelectorAll(".prompt").forEach((element)=>{
                element.style.color = command.split(" ")[3]
            })
            document.querySelectorAll(".output").forEach((element)=>{
                element.style.color = command.split(" ")[3]
            })

            return
        }
        if(command.split(" ")[2] === "-command"){
            document.querySelectorAll(".commandInput").forEach((element)=>{
                element.style.color = command.split(" ")[3]
            })
            document.querySelectorAll(".postPrompt").forEach((element)=>{
                element.style.color = command.split(" ")[3]
            })

            return
        }
        document.getElementsByClassName("terminal-body")[0].style.fontSize = command.split(" ")[2] + "px"
    }else{
        addLine("Invalid Syntax")
        addLine("     ")
        addLine("Use the font module by using this syntax : ")
        addLine("   font -family/size (value)")
    }
    

    input.focus();
    return;
  }

   if (command.split(" ")[0] == "admin") {
    let route = "/"
    let method = "POST"
    headers = {
        "Content-Type" : "application/json",
        "x-admin" : "true"
    }
    let payload = {}

    fetch(route, {
        method,
        headers,
        body : JSON.stringify(payload)
    }).then((response)=>{
        return response.json(), response.status
    }).then((answer, answerStatus)=>{
        addLine(`Response Status : `+answerStatus)
        if(answerStatus > 199 && answerStatus < 300){
            addLine(answer.msg)
        }
    })

    input.focus();
    return;
  }

  // Everything else
  addLine(
    `${escapeHTML(command)}: command not found`,
    "error"
  );

  scrollToBottom();
}

input.addEventListener("keydown", event => {

  // Execute command
  if (event.key === "Enter") {
    const command = input.value;

    input.value = "";

    execute(command);

    return;
  }

  // Previous command
  if (event.key === "ArrowUp") {

    event.preventDefault();

    if (history.length === 0) return;

    historyIndex--;

    if (historyIndex < 0) {
      historyIndex = 0;
    }

    input.value = history[historyIndex];

    return;
  }

  // Next command
  if (event.key === "ArrowDown") {

    event.preventDefault();

    if (history.length === 0) return;

    historyIndex++;

    if (historyIndex >= history.length) {
      historyIndex = history.length;
      input.value = "";
      return;
    }

    input.value = history[historyIndex];
  }
});

// Clicking anywhere focuses the input
document.addEventListener("click", () => {
  input.focus();
});

input.focus();
scrollToBottom();
</script>

</body>
</html>